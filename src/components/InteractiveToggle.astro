---
// Toggle that reveals the interactive puzzle viewers on dense pages.
// Viewers (elements with [data-puzzle-activate]) stay hidden until enabled.
---

<div class="not-content mb-4 flex items-center gap-3">
	<button
		id="interactive-toggle"
		type="button"
		aria-pressed="false"
		class="cursor-pointer rounded-full border border-gray-400 px-5 py-1.5 text-sm font-medium text-gray-700 transition-colors hover:bg-indigo-50 dark:border-gray-300 dark:text-gray-200 dark:hover:bg-indigo-950"
	>
		Enable interactive viewers
	</button>
	<span class="text-sm font-medium text-yellow-500 dark:text-yellow-400">(Experimental)</span>
</div>

<style>
	#interactive-toggle[aria-pressed='true'] {
		background: linear-gradient(90deg, #6366f1, #8b5cf6);
		border-color: transparent;
		color: white;
	}
</style>

<style is:global>
	#alg-container [data-puzzle-activate] {
		display: none;
	}
	#alg-container.interactive-enabled [data-puzzle-activate] {
		display: revert;
	}
</style>

<script>
	const btn = document.getElementById('interactive-toggle');
	const container = document.getElementById('alg-container');

	btn?.addEventListener('click', () => {
		container?.classList.toggle('interactive-enabled');
		const enabled = container?.classList.contains('interactive-enabled') ?? false;
		btn.setAttribute('aria-pressed', String(enabled));
		btn.textContent = enabled ? 'Disable interactive viewers' : 'Enable interactive viewers';
	});
</script>
