---
import type { CollectionEntry } from 'astro:content';
import PuzzleViewer from './PuzzleViewer.astro';

type AlgCase = CollectionEntry<'algs'>['data']['cases'][number];

interface Props {
	case: AlgCase;
	setupPrefix?: string;
	setupSuffix?: string;
	showViewer?: boolean;
	hintFacelets?: boolean;
}

const { case: c, setupPrefix, setupSuffix, showViewer = true, hintFacelets = false } = Astro.props;
// Per-case thumbnails are generated into public/thumbnails/<id>.webp by
// `npm run thumbnails`. Fall back to the placeholder if missing.
import { existsSync } from 'node:fs';
const generated = `/Bencisco/thumbnails/${c.id}.webp`;
const thumbnail =
	c.thumbnail ?? (existsSync(`${process.cwd()}/public/thumbnails/${c.id}.webp`) ? generated : '/Bencisco/thumbnails/placeholder.svg');

// Collect showcase algs with per-alg orientation labels.
// showcase_label applies to showcase_alg; variants without their own label
// (showcase_label1, showcase_label2, ...) inherit the case-level label.
interface ShowcaseAlg {
	alg: string;
	label: string | null;
}

const showcaseAlgs: ShowcaseAlg[] = [];

if (c.showcase_alg) {
	showcaseAlgs.push({ alg: c.showcase_alg, label: c.showcase_label ?? null });
}

for (let i = 1; ; i++) {
	const algKey = `showcase_alg${i}` as keyof typeof c;
	const labelKey = `showcase_label${i}` as keyof typeof c;
	if (typeof c[algKey] === 'string') {
		const variantLabel = typeof c[labelKey] === 'string' ? (c[labelKey] as string) : (c.showcase_label ?? null);
		showcaseAlgs.push({ alg: c[algKey] as string, label: variantLabel });
	} else {
		break;
	}
}

// Display logic: group by orientation label.
const uniqueLabels = new Set(showcaseAlgs.map((a) => a.label));
const allSameOrientation = uniqueLabels.size <= 1;

let visibleAlgs: ShowcaseAlg[];
let hiddenAlgs: ShowcaseAlg[];

if (allSameOrientation && showcaseAlgs.length > 1) {
	visibleAlgs = [showcaseAlgs[0]];
	hiddenAlgs = showcaseAlgs.slice(1);
} else if (!allSameOrientation) {
	const seen = new Set<string | null>();
	const shown: ShowcaseAlg[] = [];
	const hidden: ShowcaseAlg[] = [];
	for (const a of showcaseAlgs) {
		if (seen.has(a.label)) {
			hidden.push(a);
		} else {
			seen.add(a.label);
			shown.push(a);
		}
	}
	visibleAlgs = shown;
	hiddenAlgs = hidden;
} else {
	visibleAlgs = showcaseAlgs;
	hiddenAlgs = [];
}

const showOtherVariants = hiddenAlgs.length > 0;
const eifLabel = `(${c.eif_label ?? 'EIF'})`;
const caseId = c.id.replace(/[^a-zA-Z0-9-]/g, '');
---

<div class="case-card flex flex-col items-center gap-2 rounded-lg border border-gray-200 p-3 dark:border-gray-700">
	<PuzzleViewer alg={c.alg} scramble={c.scramble} thumbnail={thumbnail} caption={c.name ?? c.id} setupPrefix={setupPrefix} setupSuffix={setupSuffix} interactive={showViewer} hintFacelets={hintFacelets} />
	<div class="flex flex-1 flex-col items-center gap-2 text-center">
		{c.name && <span class="font-semibold">{c.name}</span>}
		{c.family && <span class="text-sm text-gray-500">{c.family}</span>}
		{visibleAlgs.map(({ alg, label }) => (
			<code class="text-sm font-bold">
				{label && <span class="font-normal text-indigo-500 dark:text-indigo-400">({label}) </span>}
				{alg}
			</code>
		))}
	</div>
	<div class="flex flex-col items-center gap-2 text-center">
		{showOtherVariants && (
			<>
				<button
					type="button"
					class="other-variants-toggle cursor-pointer rounded-md px-2 py-0.5 text-sm text-indigo-500 hover:text-indigo-700 hover:underline dark:text-indigo-400 dark:hover:text-indigo-300"
				>
					Other variants
				</button>
				<div class={`other-variants-${caseId} hidden flex flex-col items-center gap-2`}>
					{hiddenAlgs.map(({ alg, label }) => (
						<code class="text-sm font-bold">
							{label && <span class="font-normal text-indigo-500 dark:text-indigo-400">({label}) </span>}
							{alg}
						</code>
					))}
				</div>
			</>
		)}
		{c.eif_alg && (
			<code class="text-sm text-gray-500 dark:text-gray-400">
				<span class="text-indigo-500 dark:text-indigo-400">{eifLabel}</span> {c.eif_alg}
			</code>
		)}
	</div>
</div>

<script>
	document.addEventListener('click', (e) => {
		const btn = (e.target as Element).closest('.other-variants-toggle');
		if (!btn) return;
		const container = btn.nextElementSibling as HTMLElement | null;
		if (container) {
			container.classList.toggle('hidden');
			btn.textContent = container.classList.contains('hidden') ? 'Other variants' : 'Hide variants';
		}
	});
</script>
