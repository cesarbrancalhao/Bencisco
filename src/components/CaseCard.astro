---
import type { CollectionEntry } from 'astro:content';
import PuzzleViewer from './PuzzleViewer.astro';
import { Alg } from 'cubing/alg';
import { cifToTwizzle } from '../scripts/fto-notation';

type AlgCase = CollectionEntry<'algs'>['data']['cases'][number];

interface Props {
	case: AlgCase;
	setupPrefix?: string;
	setupSuffix?: string;
	algPrefix?: string;
	cameraLongitude?: number;
	stickeringMask?: string;
	showViewer?: boolean;
	hintFacelets?: boolean;
	textAlign?: 'center' | 'left';
	note?: string;
	showButtons?: boolean;
}

const { case: c, setupPrefix, setupSuffix, algPrefix, cameraLongitude, stickeringMask, showViewer = true, hintFacelets = false, textAlign = 'center', note, showButtons = false } = Astro.props;
import { existsSync } from 'node:fs';
const generated = `/Bencisco/thumbnails/${c.id}.webp`;
const placeholder = '/Bencisco/thumbnails/placeholder.svg';
const thumbnail =
	c.thumbnail ?? (existsSync(`${process.cwd()}/public/thumbnails/${c.id}.webp`) ? generated : placeholder);

const hasOlpParity = !!(c.even_scramble !== undefined && c.odd_scramble !== undefined);

const evenThumbnail = hasOlpParity
	? (c.thumbnail ?? (existsSync(`${process.cwd()}/public/thumbnails/${c.id}-even.webp`) ? `/Bencisco/thumbnails/${c.id}-even.webp` : placeholder))
	: thumbnail;

const oddThumbnail = hasOlpParity
	? (c.thumbnail ?? (existsSync(`${process.cwd()}/public/thumbnails/${c.id}-odd.webp`) ? `/Bencisco/thumbnails/${c.id}-odd.webp` : placeholder))
	: thumbnail;

const evenScramble = (c.even_scramble !== undefined ? c.even_scramble : undefined) ?? c.scramble;
const oddScramble = c.odd_scramble;
const evenAlg = c.even_alg ?? c.alg;
const oddAlg = c.odd_alg ?? c.alg;

interface ShowcaseAlg {
	alg: string;
	label: string | null;
}

const showcaseAlgs: ShowcaseAlg[] = [];

if (c.showcase_alg) {
	showcaseAlgs.push({ alg: c.showcase_alg, label: c.showcase_label ?? null });
}

for (let i = 1; ; i++) {
	const algKey = `showcase_alg${i}` as keyof typeof c;
	const labelKey = `showcase_label${i}` as keyof typeof c;
	if (typeof c[algKey] === 'string') {
		const variantLabel = typeof c[labelKey] === 'string' ? (c[labelKey] as string) : (c.showcase_label ?? null);
		showcaseAlgs.push({ alg: c[algKey] as string, label: variantLabel });
	} else {
		break;
	}
}

const uniqueLabels = new Set(showcaseAlgs.map((a) => a.label));
const allSameOrientation = uniqueLabels.size <= 1;

let visibleAlgs: ShowcaseAlg[];
let hiddenAlgs: ShowcaseAlg[];

if (allSameOrientation && showcaseAlgs.length > 1) {
	visibleAlgs = [showcaseAlgs[0]];
	hiddenAlgs = showcaseAlgs.slice(1);
} else if (!allSameOrientation) {
	const seen = new Set<string | null>();
	const shown: ShowcaseAlg[] = [];
	const hidden: ShowcaseAlg[] = [];
	for (const a of showcaseAlgs) {
		if (seen.has(a.label)) {
			hidden.push(a);
		} else {
			seen.add(a.label);
			shown.push(a);
		}
	}
	visibleAlgs = shown;
	hiddenAlgs = hidden;
} else {
	visibleAlgs = showcaseAlgs;
	hiddenAlgs = [];
}

const nonParityVisibleAlgs = hasOlpParity
	? visibleAlgs.filter((a) => a.label !== 'Even' && a.label !== 'Odd')
	: visibleAlgs;

const showOtherVariants = hiddenAlgs.length > 0 && !hasOlpParity;

const olpEvenAlg = hasOlpParity ? showcaseAlgs.find((a) => a.label === 'Even') : undefined;
const olpOddAlg = hasOlpParity ? showcaseAlgs.find((a) => a.label === 'Odd') : undefined;

const shorterIsOdd = hasOlpParity && olpEvenAlg && olpOddAlg
	? olpOddAlg.alg.length < olpEvenAlg.alg.length
	: false;

const eifLabel = `(${c.eif_label ?? 'EIF'})`;
const caseId = c.id.replace(/[^a-zA-Z0-9-]/g, '');
const isSolved = c.showcase_alg === 'solved' || c.alg === '';

function renderAlg(alg: string): string {
	return alg.replace(
		/\(([^)]+)\)/g,
		'<span class="text-red-500 dark:text-red-400">$1</span>',
	);
}

// --- Precompute twizzle-mapped algs & setup-algs for the modal JSON ---
function computeEffectiveAlg(alg: string, suffix?: string): string {
	const twizzle = cifToTwizzle(alg);
	if (suffix) {
		try { return new Alg(`${twizzle} ${suffix}`).toString(); } catch { return twizzle; }
	}
	return twizzle;
}

function computeSetupAlg(alg: string, scrambleStr: string | undefined, prefix?: string, suffix?: string, algPfx?: string): string | undefined {
	try {
		const twizzle = cifToTwizzle(alg);
		const pre = prefix ? `${prefix} ` : '';
		const suf = suffix ? ` ${suffix}` : '';
		const pfx = algPfx ? ` ${algPfx}` : '';
		const scr = scrambleStr ?? new Alg(twizzle).invert().toString();
		return new Alg(`${pre}${scr}${suf}${pfx}`).toString();
	} catch {
		return undefined;
	}
}

const modalEffectiveAlg = computeEffectiveAlg(c.alg, setupSuffix);
const modalSetupAlg = computeSetupAlg(c.alg, c.scramble, setupPrefix, setupSuffix, algPrefix);

let modalEvenEffectiveAlg: string | undefined;
let modalEvenSetupAlg: string | undefined;
let modalOddEffectiveAlg: string | undefined;
let modalOddSetupAlg: string | undefined;

if (hasOlpParity) {
	modalEvenEffectiveAlg = computeEffectiveAlg(evenAlg, setupSuffix);
	modalEvenSetupAlg = computeSetupAlg(evenAlg, evenScramble, setupPrefix, setupSuffix, algPrefix);
	modalOddEffectiveAlg = computeEffectiveAlg(oddAlg, setupSuffix);
	modalOddSetupAlg = computeSetupAlg(oddAlg, oddScramble, setupPrefix, setupSuffix, algPrefix);
}

const caseData = {
	id: c.id,
	name: c.name ?? null,
	family: c.family ?? null,
	pairs: c.pairs ?? null,
	scramble: c.scramble ?? null,
	evenScramble: c.even_scramble ?? null,
	oddScramble: c.odd_scramble ?? null,
	effectiveAlg: modalEffectiveAlg,
	setupAlg: modalSetupAlg ?? null,
	showcaseAlgs,
	eifAlg: c.eif_alg ?? null,
	eifLabel: c.eif_label ?? null,
	hasOlpParity,
	evenAlg: c.even_alg ?? null,
	evenEffectiveAlg: modalEvenEffectiveAlg ?? null,
	evenSetupAlg: modalEvenSetupAlg ?? null,
	evenThumbnail: hasOlpParity ? evenThumbnail : null,
	oddAlg: c.odd_alg ?? null,
	oddEffectiveAlg: modalOddEffectiveAlg ?? null,
	oddSetupAlg: modalOddSetupAlg ?? null,
	oddThumbnail: hasOlpParity ? oddThumbnail : null,
	cameraLongitude: cameraLongitude ?? null,
	stickeringMask: stickeringMask ?? null,
	hintFacelets,
	thumbnail,
	shorterIsOdd,
};
---

<div class={`case-card flex flex-col items-center gap-2 rounded-lg border border-gray-200 p-3 dark:border-gray-700${showButtons ? ' relative' : ''}`} data-case-id={c.id}>
	{
		hasOlpParity ? (
			<>
				<div class={`puzzle-parity-panel${shorterIsOdd ? ' hidden' : ''}`} data-parity="even">
					<PuzzleViewer alg={evenAlg} scramble={evenScramble} thumbnail={evenThumbnail} caption={c.name ?? c.id} setupPrefix={setupPrefix} setupSuffix={setupSuffix} algPrefix={algPrefix} cameraLongitude={cameraLongitude} stickeringMask={stickeringMask} interactive={showViewer} hintFacelets={hintFacelets} />
				</div>
				<div class={`puzzle-parity-panel${shorterIsOdd ? '' : ' hidden'}`} data-parity="odd">
					<PuzzleViewer alg={oddAlg} scramble={oddScramble} thumbnail={oddThumbnail} caption={c.name ?? c.id} setupPrefix={setupPrefix} setupSuffix={setupSuffix} algPrefix={algPrefix} cameraLongitude={cameraLongitude} stickeringMask={stickeringMask} interactive={showViewer} hintFacelets={hintFacelets} />
				</div>
			</>
		) : (
			<PuzzleViewer alg={c.alg} scramble={c.scramble} thumbnail={thumbnail} caption={c.name ?? c.id} setupPrefix={setupPrefix} setupSuffix={setupSuffix} algPrefix={algPrefix} cameraLongitude={cameraLongitude} stickeringMask={stickeringMask} interactive={showViewer} hintFacelets={hintFacelets} />
		)
	}
	<div class="flex flex-col items-center gap-1 text-center">
		{c.name && <span class="font-semibold">{c.name}</span>}
		{(c.pairs ?? c.family) && <span class="text-sm text-gray-500">{c.pairs ?? c.family}</span>}
	</div>
	<div class={`flex flex-1 flex-col gap-2 ${textAlign === 'left' ? 'items-start text-left' : 'items-center text-center'}`}>
		{hasOlpParity && olpEvenAlg && olpOddAlg ? (
			<div class="flex flex-col gap-1.5">
				{shorterIsOdd ? (
					<>
						<button type="button" class="olp-parity-btn cursor-pointer rounded-md border-2 border-indigo-500 bg-indigo-50 px-2.5 py-1 text-xs font-bold text-indigo-700 dark:border-indigo-400 dark:bg-indigo-950 dark:text-indigo-300" data-parity="odd">
							{olpOddAlg.label && <span class="olp-parity-label font-normal text-indigo-700 dark:text-indigo-300">({olpOddAlg.label}) </span>}
							<Fragment set:html={renderAlg(olpOddAlg.alg)} />
						</button>
						<button type="button" class="olp-parity-btn cursor-pointer rounded-md border border-gray-300 px-2.5 py-1 text-xs font-bold text-gray-500 hover:border-indigo-300 dark:border-gray-600 dark:text-gray-400 dark:hover:border-indigo-500" data-parity="even">
							{olpEvenAlg.label && <span class="olp-parity-label font-normal text-indigo-500 dark:text-indigo-400">({olpEvenAlg.label}) </span>}
							<Fragment set:html={renderAlg(olpEvenAlg.alg)} />
						</button>
					</>
				) : (
					<>
						<button type="button" class="olp-parity-btn cursor-pointer rounded-md border-2 border-indigo-500 bg-indigo-50 px-2.5 py-1 text-xs font-bold text-indigo-700 dark:border-indigo-400 dark:bg-indigo-950 dark:text-indigo-300" data-parity="even">
							{olpEvenAlg.label && <span class="olp-parity-label font-normal text-indigo-700 dark:text-indigo-300">({olpEvenAlg.label}) </span>}
							<Fragment set:html={renderAlg(olpEvenAlg.alg)} />
						</button>
						<button type="button" class="olp-parity-btn cursor-pointer rounded-md border border-gray-300 px-2.5 py-1 text-xs font-bold text-gray-500 hover:border-indigo-300 dark:border-gray-600 dark:text-gray-400 dark:hover:border-indigo-500" data-parity="odd">
							{olpOddAlg.label && <span class="olp-parity-label font-normal text-indigo-500 dark:text-indigo-400">({olpOddAlg.label}) </span>}
							<Fragment set:html={renderAlg(olpOddAlg.alg)} />
						</button>
					</>
				)}
			</div>
		) : (
			visibleAlgs.map(({ alg, label }) => (
				<code class="text-sm font-bold">
					{label && <span class="font-normal text-indigo-500 dark:text-indigo-400">({label}) </span>}
					<Fragment set:html={renderAlg(alg)} />
				</code>
			))
		)}
	</div>
	<div class={`flex flex-col gap-2 ${textAlign === 'left' ? 'items-start text-left' : 'items-center text-center'}`}>
		{hasOlpParity ? (
			nonParityVisibleAlgs.length > 0 && nonParityVisibleAlgs.map(({ alg, label }) => (
				<code class="text-sm font-bold">
					{label && <span class="font-normal text-indigo-500 dark:text-indigo-400">({label}) </span>}
					<Fragment set:html={renderAlg(alg)} />
				</code>
			))
		) : (
			<>
				{showOtherVariants && (
					<>
						<button
							type="button"
							class="other-variants-toggle cursor-pointer rounded-md px-2 py-0.5 text-sm text-indigo-500 hover:text-indigo-700 hover:underline dark:text-indigo-400 dark:hover:text-indigo-300"
						>
							Other variants
						</button>
						<div class={`other-variants-${caseId} hidden flex flex-col gap-2 ${textAlign === 'left' ? 'items-start' : 'items-center'}`}>
							{hiddenAlgs.map(({ alg, label }) => (
								<code class="text-sm font-bold">
									{label && <span class="font-normal text-indigo-500 dark:text-indigo-400">({label}) </span>}
									<Fragment set:html={renderAlg(alg)} />
								</code>
							))}
						</div>
					</>
				)}
			</>
		)}
		{c.eif_alg && (
			<code class="text-sm text-gray-500 dark:text-gray-400">
				<span class="text-indigo-500 dark:text-indigo-400">{eifLabel}</span> <Fragment set:html={renderAlg(c.eif_alg)} />
			</code>
		)}
		{note && <div class="mt-1 text-sm text-gray-500 dark:text-gray-400 text-center">{note}</div>}
	</div>
	{
		showButtons && (
			<>
				<button
					type="button"
					class="case-expand-btn absolute top-1 left-1 z-10 cursor-pointer rounded-md bg-white/80 p-1 text-gray-500 opacity-50 shadow-sm transition-opacity hover:opacity-100 dark:bg-gray-900/80 dark:text-gray-300"
					title="Expand"
				>
					<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
						<path fill-rule="evenodd" d="M5.828 10.172a.5.5 0 0 0-.707 0l-4.096 4.096V11.5a.5.5 0 0 0-1 0v3.975a.5.5 0 0 0 .5.5H4.5a.5.5 0 0 0 0-1H1.732l4.096-4.096a.5.5 0 0 0 0-.707m4.344 0a.5.5 0 0 1 .707 0l4.096 4.096V11.5a.5.5 0 1 1 1 0v3.975a.5.5 0 0 1-.5.5H11.5a.5.5 0 0 1 0-1h2.768l-4.096-4.096a.5.5 0 0 1 0-.707m0-4.344a.5.5 0 0 0 .707 0l4.096-4.096V4.5a.5.5 0 1 0 1 0V.525a.5.5 0 0 0-.5-.5H11.5a.5.5 0 0 0 0 1h2.768l-4.096 4.096a.5.5 0 0 0 0 .707m-4.344 0a.5.5 0 0 1-.707 0L1.025 1.732V4.5a.5.5 0 0 1-1 0V.525a.5.5 0 0 1 .5-.5H4.5a.5.5 0 0 1 0 1H1.732l4.096 4.096a.5.5 0 0 1 0 .707"/>
					</svg>
				</button>
				{!isSolved && (
					<button
						type="button"
						class="case-learned-btn absolute top-1 right-1 z-10 cursor-pointer rounded-md bg-white/80 p-1 text-gray-500 opacity-50 shadow-sm transition-opacity hover:opacity-100 dark:bg-gray-900/80 dark:text-gray-300"
						title="Mark as learned"
						data-case-id={c.id}
					>
						<svg class="icon-outline" xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
							<path d="M8.211 2.047a.5.5 0 0 0-.422 0l-7.5 3.5a.5.5 0 0 0 .025.917l7.5 3a.5.5 0 0 0 .372 0L14 7.14V13a1 1 0 0 0-1 1v2h3v-2a1 1 0 0 0-1-1V6.739l.686-.275a.5.5 0 0 0 .025-.917zM8 8.46 1.758 5.965 8 3.052l6.242 2.913z"/>
							<path d="M4.176 9.032a.5.5 0 0 0-.656.327l-.5 1.7a.5.5 0 0 0 .294.605l4.5 1.8a.5.5 0 0 0 .372 0l4.5-1.8a.5.5 0 0 0 .294-.605l-.5-1.7a.5.5 0 0 0-.656-.327L8 10.466zm-.068 1.873.22-.748 3.496 1.311a.5.5 0 0 0 .352 0l3.496-1.311.22.748L8 12.46z"/>
						</svg>
						<svg class="icon-fill hidden" xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
							<path d="M8.211 2.047a.5.5 0 0 0-.422 0l-7.5 3.5a.5.5 0 0 0 .025.917l7.5 3a.5.5 0 0 0 .372 0L14 7.14V13a1 1 0 0 0-1 1v2h3v-2a1 1 0 0 0-1-1V6.739l.686-.275a.5.5 0 0 0 .025-.917z"/>
							<path d="M4.176 9.032a.5.5 0 0 0-.656.327l-.5 1.7a.5.5 0 0 0 .294.605l4.5 1.8a.5.5 0 0 0 .372 0l4.5-1.8a.5.5 0 0 0 .294-.605l-.5-1.7a.5.5 0 0 0-.656-.327L8 10.466z"/>
						</svg>
					</button>
				)}
				<div class="hidden case-data" set:html={JSON.stringify(caseData)}></div>
			</>
		)
	}
</div>

<script>
	document.addEventListener('click', (e) => {
		const btn = (e.target as Element).closest('.other-variants-toggle');
		if (!btn) return;
		const container = btn.nextElementSibling as HTMLElement | null;
		if (container) {
			container.classList.toggle('hidden');
			btn.textContent = container.classList.contains('hidden') ? 'Other variants' : 'Hide variants';
		}
	});

	document.addEventListener('click', (e) => {
		const btn = (e.target as Element).closest('.olp-parity-btn') as HTMLElement | null;
		if (!btn) return;
		const parity = btn.dataset.parity;
		if (!parity) return;

		const card = btn.closest('.case-card') as HTMLElement | null;
		if (!card) return;

		card.querySelectorAll('.olp-parity-btn').forEach((b) => {
			const el = b as HTMLElement;
			const isActive = el.dataset.parity === parity;
			const label = el.querySelector<HTMLElement>('.olp-parity-label');
			if (isActive) {
				el.className = 'olp-parity-btn cursor-pointer rounded-md border-2 border-indigo-500 bg-indigo-50 px-2.5 py-1 text-xs font-bold text-indigo-700 dark:border-indigo-400 dark:bg-indigo-950 dark:text-indigo-300';
				if (label) label.className = 'olp-parity-label font-normal text-indigo-700 dark:text-indigo-300';
			} else {
				el.className = 'olp-parity-btn cursor-pointer rounded-md border border-gray-300 px-2.5 py-1 text-xs font-bold text-gray-500 hover:border-indigo-300 dark:border-gray-600 dark:text-gray-400 dark:hover:border-indigo-500';
				if (label) label.className = 'olp-parity-label font-normal text-indigo-500 dark:text-indigo-400';
			}
		});

		card.querySelectorAll<HTMLElement>('.puzzle-parity-panel').forEach((panel) => {
			panel.classList.toggle('hidden', panel.dataset.parity !== parity);
		});

		card.querySelectorAll<HTMLElement>('[data-puzzle-viewer]').forEach((viewer) => {
			viewer.dispatchEvent(new CustomEvent('puzzle-viewer:restore', { bubbles: true }));
		});
	});
</script>
