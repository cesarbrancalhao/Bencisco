---
/**
 * Dice-button toggle for cases-per-row density on alg pages (2 / 3 / 4).
 * Selected density is persisted in localStorage and applied via the
 * `data-density` attribute on `.alg-density-root` (see global.css).
 * 2 = magnified cards, 3 = default, 4 = compact cards.
 * Only affects `.case-card` contents; the rest of the page is untouched.
 */

const DIE_OUTLINE =
	'M13 1a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V3a2 2 0 0 1 2-2zM3 0a3 3 0 0 0-3 3v10a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3V3a3 3 0 0 0-3-3z';

const dice: { n: string; pips: string; fill: string }[] = [
	{
		n: '2',
		pips: 'M5.5 4a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0m8 8a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0',
		fill: 'M0 3a3 3 0 0 1 3-3h10a3 3 0 0 1 3 3v10a3 3 0 0 1-3 3H3a3 3 0 0 1-3-3zm5.5 1a1.5 1.5 0 1 0-3 0 1.5 1.5 0 0 0 3 0m6.5 9.5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3',
	},
	{
		n: '3',
		pips: 'M5.5 4a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0m8 8a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0m-4-4a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0',
		fill: 'M3 0a3 3 0 0 0-3 3v10a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3V3a3 3 0 0 0-3-3zm2.5 4a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0m8 8a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0M8 9.5a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3',
	},
	{
		n: '4',
		pips: 'M5.5 4a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0m8 0a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0m0 8a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0m-8 0a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0',
		fill: 'M3 0a3 3 0 0 0-3 3v10a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3V3a3 3 0 0 0-3-3zm1 5.5a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3m8 0a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3m1.5 6.5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0M4 13.5a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3',
	},
];

const btnBase = 'density-btn cursor-pointer rounded-md border-2 p-1.5';
const btnSelected = `${btnBase} border-indigo-500 bg-indigo-50 text-indigo-700 dark:border-indigo-400 dark:bg-indigo-950 dark:text-indigo-300`;
const btnUnselected = `${btnBase} border-transparent text-gray-500 hover:text-indigo-500 dark:text-gray-400 dark:hover:text-indigo-400`;
---

<div class="case-density-toggle not-content mb-3 flex flex-col items-center gap-1.5">
	<div class="flex gap-1" role="group" aria-label="Cases per row">
		{
			dice.map(({ n, pips, fill }) => (
				<button
					type="button"
					class={n === '3' ? btnSelected : btnUnselected}
					data-density={n}
					title={`${n} cases per row`}
					aria-pressed={n === '3' ? 'true' : 'false'}
				>
					<svg class:list={['icon-outline', { hidden: n === '3' }]} xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
						<path d={DIE_OUTLINE} />
						<path d={pips} />
					</svg>
					<svg class:list={['icon-fill', { hidden: n !== '3' }]} xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
						<path d={fill} />
					</svg>
				</button>
			))
		}
	</div>
</div>

<script>
	const DENSITY_KEY = 'fto-case-density';
	const BTN_BASE = 'density-btn cursor-pointer rounded-md border-2 p-1.5';
	const BTN_SELECTED = `${BTN_BASE} border-indigo-500 bg-indigo-50 text-indigo-700 dark:border-indigo-400 dark:bg-indigo-950 dark:text-indigo-300`;
	const BTN_UNSELECTED = `${BTN_BASE} border-transparent text-gray-500 hover:text-indigo-500 dark:text-gray-400 dark:hover:text-indigo-400`;

	function applyDensity(density: string): void {
		document.querySelectorAll<HTMLElement>('.alg-density-root').forEach((root) => {
			root.dataset.density = density;
		});
		document.querySelectorAll<HTMLButtonElement>('.density-btn').forEach((btn) => {
			const active = btn.dataset.density === density;
			btn.className = active ? BTN_SELECTED : BTN_UNSELECTED;
			btn.setAttribute('aria-pressed', String(active));
			btn.querySelector('.icon-outline')?.classList.toggle('hidden', active);
			btn.querySelector('.icon-fill')?.classList.toggle('hidden', !active);
		});
	}

	const stored = localStorage.getItem(DENSITY_KEY);
	applyDensity(stored === '2' || stored === '4' ? stored : '3');

	document.addEventListener('click', (e) => {
		const btn = (e.target as Element).closest<HTMLButtonElement>('.density-btn');
		if (!btn?.dataset.density) return;
		localStorage.setItem(DENSITY_KEY, btn.dataset.density);
		applyDensity(btn.dataset.density);
	});
</script>
