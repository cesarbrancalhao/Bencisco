---
/**
 * Renders one step of an example solve from a YAML data file in src/data/
 * (e.g. src="samples/ben-streeter", id="ben-01") as a directly embedded
 * interactive player — example-solve pages are low-density, so no thumbnail.
 *
 * `alg`/`scramble` are CIF community notation; PuzzleViewer normalizes them
 * via resolveCif (wide/slice/H-S tokens only — faces are 1:1 with cubing.js).
 */
import { getEntry } from 'astro:content';
import PuzzleViewer from './PuzzleViewer.astro';

interface Props {
	src: string;
	id: string;
	cameraLongitude?: number;
	cameraLatitude?: number;
}

const { src, id, cameraLongitude, cameraLatitude } = Astro.props;
const entry = await getEntry('algs', src);
if (!entry) throw new Error(`SolveStep: no data file found at src/data/${src}.yaml`);
const step = entry.data.cases.find((c) => c.id === id);
if (!step) throw new Error(`SolveStep: no case '${id}' in src/data/${src}.yaml`);
---

<PuzzleViewer
	alg={step.alg}
	scramble={step.scramble}
	caption={step.name ?? step.id}
	cameraLongitude={cameraLongitude ?? entry.data.camera_longitude}
	cameraLatitude={cameraLatitude}
/>
