---
/**
 * Thumbnail-first FTO viewer.
 *
 * - With `thumbnail`: renders a static image + "View interactive" button.
 *   cubing.js is fetched only on click (singleton - one player at a time).
 * - Without `thumbnail`: embeds <twisty-player> directly (use only on
 *   low-density pages: tutorials, example solves).
 *
 * `startState`:
 * - "case" (default): the puzzle starts in the unsolved case state and the
 *   alg solves it (via `experimental-setup-alg` = inverse of the alg).
 * - "solved": the puzzle starts solved and the alg is applied to it
 *   (for notation demos, etc.).
 */
import { Alg } from 'cubing/alg';
import { resolveCif } from '../scripts/fto-notation';

interface Props {
	alg: string;
	scramble?: string;
	puzzle?: string;
	thumbnail?: string;
	caption?: string;
	startState?: 'case' | 'solved';
	setupPrefix?: string;
	setupSuffix?: string;
	algPrefix?: string;
	cameraLongitude?: number;
	cameraLatitude?: number;
	cameraLatitudeLimit?: number;
	stickeringMask?: string;
	interactive?: boolean;
	hintFacelets?: boolean;
}

const {
	alg,
	scramble,
	puzzle = 'fto',
	thumbnail,
	caption,
	startState = 'case',
	setupPrefix,
	setupSuffix,
	algPrefix,
	cameraLongitude,
	cameraLatitude,
	cameraLatitudeLimit,
	stickeringMask,
	interactive = true,
	hintFacelets = false,
} = Astro.props;

// `alg` and `scramble` are CIF community notation; cubing.js FTO uses the same
// face names, so resolveCif only normalizes community-only tokens (Xw/Xs/H/S).
const resolvedAlg = resolveCif(alg);

let setupAlg: string | undefined;
if (startState === 'case') {
	try {
		const prefix = setupPrefix ? `${setupPrefix} ` : '';
		const suffix = setupSuffix ? ` ${setupSuffix}` : '';
		const postfix = algPrefix ? ` ${algPrefix}` : '';
		const scrambleAlg = scramble ? resolveCif(scramble) : new Alg(resolvedAlg).invert().toString();
		setupAlg = new Alg(`${prefix}${scrambleAlg}${suffix}${postfix}`).toString();
	} catch {
		setupAlg = undefined;
	}
}

let effectiveAlg = resolvedAlg;
if (setupSuffix) {
	try {
		effectiveAlg = new Alg(`${effectiveAlg} ${setupSuffix}`).toString();
	} catch {
		// keep original alg if suffix can't be parsed
	}
}
---

{
	thumbnail ? (
		<div
			class="puzzle-viewer not-content flex flex-col items-center gap-2"
			data-puzzle-viewer
			data-mode="thumbnail"
			data-puzzle={puzzle}
			data-alg={effectiveAlg}
			data-setup-alg={setupAlg}
			data-camera-longitude={cameraLongitude}
			data-camera-latitude={cameraLatitude}
			data-camera-latitude-limit={cameraLatitudeLimit}
			data-stickering-mask={stickeringMask}
			data-hint-facelets={hintFacelets ? undefined : 'none'}
		>
			<img
				src={thumbnail}
				alt={caption ?? `FTO case`}
				width="256"
				height="192"
				loading="lazy"
				class="rounded-lg border border-gray-200 dark:border-gray-700"
			/>
			{interactive && (
				<button
					type="button"
					data-puzzle-activate
					class="cursor-pointer rounded-md bg-gray-100 px-3 py-1 text-sm font-medium text-gray-800 hover:bg-gray-200 dark:bg-gray-800 dark:text-gray-100 dark:hover:bg-gray-700"
				>
					View interactive
				</button>
			)}
		</div>
	) : (
		<div class="puzzle-viewer not-content" data-puzzle-viewer data-mode="direct">
			<twisty-player
				puzzle={puzzle}
				alg={effectiveAlg}
				experimental-setup-alg={setupAlg}
				camera-longitude={cameraLongitude}
				camera-latitude={cameraLatitude}
				camera-latitude-limit={cameraLatitudeLimit}
				experimental-stickering-mask-orbits={stickeringMask}
				hint-facelets={hintFacelets ? undefined : 'none'}
				background="none"
				style="width: 256px; height: 192px;"
			/>
		</div>
	)
}

<script src="../scripts/puzzle-viewer.ts"></script>
