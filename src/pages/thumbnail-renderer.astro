---
/**
 * Build tooling — NOT a site page (unlinked, no layout).
 * Renders every alg case at its unsolved case state, one <twisty-player>
 * per case, so scripts/generate-thumbnails.mjs can screenshot them into
 * public/thumbnails/<case-id>.webp.
 *
 * When a case has even_scramble / odd_scramble (OLP), separate even/odd
 * players are rendered under <case-id>-even / <case-id>-odd data attributes
 * so the screenshot script produces paired thumbnails.
 */
import { getCollection } from 'astro:content';
import { Alg } from 'cubing/alg';
import { cifToTwizzle } from '../scripts/fto-notation';

const algs = await getCollection('algs');

interface ThumbEntry {
	id: string;
	setupAlg: string;
	effectiveAlg: string;
	topDown: boolean;
	stickeringMask: string | undefined;
}

const entries: ThumbEntry[] = [];

for (const entry of algs) {
	for (const c of entry.data.cases) {
		const setupPrefix = c.preset ?? entry.data.family_prefixes?.[c.family ?? ''] ?? entry.data.setup_prefix;
		const setupSuffix = c.postset ?? entry.data.family_suffixes?.[c.family ?? ''] ?? entry.data.setup_suffix;
		const twizzleAlg = cifToTwizzle(c.alg);
		const topDown = entry.data.top_down ?? false;
		const stickeringMask = entry.data.stickering_mask;

		function buildSetupAlg(scramble: string | undefined): string | undefined {
			try {
				const prefix = setupPrefix ? `${setupPrefix} ` : '';
				const suffix = setupSuffix ? ` ${setupSuffix}` : '';
				const scrambleAlg = scramble !== undefined ? scramble : new Alg(twizzleAlg).invert().toString();
				return new Alg(`${prefix}${scrambleAlg}${suffix}`).toString();
			} catch {
				return undefined;
			}
		}

		function buildEffectiveAlg(): string {
			let effectiveAlg = twizzleAlg;
			if (setupSuffix) {
				try {
					effectiveAlg = new Alg(`${twizzleAlg} ${setupSuffix}`).toString();
				} catch {
					// keep original
				}
			}
			return effectiveAlg;
		}

		// Main thumbnail (id = case.id)
		const mainSetup = buildSetupAlg(c.scramble);
		if (mainSetup) {
			entries.push({
				id: c.id,
				setupAlg: mainSetup,
				effectiveAlg: buildEffectiveAlg(),
				topDown,
				stickeringMask,
			});
		}

		// Even / odd variants for OLP
		if (c.even_scramble !== undefined && c.odd_scramble !== undefined) {
			const evenSetup = buildSetupAlg(c.even_scramble);
			if (evenSetup) {
				entries.push({
					id: `${c.id}-even`,
					setupAlg: evenSetup,
					effectiveAlg: buildEffectiveAlg(),
					topDown,
					stickeringMask,
				});
			}
			const oddSetup = buildSetupAlg(c.odd_scramble);
			if (oddSetup) {
				entries.push({
					id: `${c.id}-odd`,
					setupAlg: oddSetup,
					effectiveAlg: buildEffectiveAlg(),
					topDown,
					stickeringMask,
				});
			}
		}
	}
}
---

<html>
	<head>
		<meta charset="utf-8" />
		<title>thumbnail renderer</title>
	</head>
	<body>
		{
			entries.map((e) => (
				<div data-thumb-case={e.id} style="width: 256px; height: 192px; display: inline-block;">
					<twisty-player
						puzzle="fto"
						alg={e.effectiveAlg}
						experimental-setup-alg={e.setupAlg}
						experimental-stickering-mask-orbits={e.stickeringMask}
						hint-facelets={e.topDown ? undefined : "none"}
						background="none"
						control-panel="none"
						camera-latitude={e.topDown ? 90 : undefined}
						camera-latitude-limit={e.topDown ? 180 : undefined}
						camera-distance={e.topDown ? 6.2 : undefined}
						style="width: 256px; height: 192px;"
					/>
				</div>
			))
		}
		<script>
			import 'cubing/twisty';
		</script>
	</body>
</html>
